# PostgreSQL (lidas pela imagem pgvector e pela aplicação)
POSTGRES_USER=papermind
POSTGRES_PASSWORD=papermind_dev
POSTGRES_DB=papermind
# Se mudar a senha acima, mude aqui também
DATABASE_URL=postgresql://papermind:papermind_dev@postgres:5432/papermind
# Redis (cache; a aplicação funciona sem ele)
REDIS_URL=redis://redis:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
# Ollama
OLLAMA_BASE_URL=http://ollama:11434
CHAT_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
LLM_NUM_PREDICT=400
LLM_TIMEOUT_SECONDS=180
# Ingestão e RAG
MAX_UPLOAD_MB=20
MAX_PAGES=60
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
RELEVANCE_THRESHOLD=0.55
GROUNDING_THRESHOLD=0.60
PROMPT_VERSION=1
VERIFIER_VERSION=3
# Interface
API_URL=http://app:8000
LOG_LEVEL=INFO
# Portas publicadas no host (só o lado do host)
APP_PORT=8000
FRONTEND_PORT=8501
